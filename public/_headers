# Security and caching headers for Cloudflare Pages / Netlify-compatible hosts.
# GitHub Pages does NOT read this file; CSP meta tag in <head> covers that case.
# Keep in sync with the meta http-equiv tag in src/app/layout.tsx.
#
# CSP rationale:
# - 'unsafe-inline' on script/style is required for Next.js inline runtime
#   chunks and Tailwind. Tighten with nonces if you migrate off static export.
# - This site is fully self-hosted (all content, media, fonts, and documents
#   are served from the origin), so no third-party origins are whitelisted.
#   If you add an embed (map, form, video), add its origin here AND to the
#   matching <meta> CSP in src/app/layout.tsx in the same commit.
#
# Header notes:
# - HSTS does NOT set `preload`; that flag is a binding promise template
#   users cannot honor without submitting their domain to hstspreload.org.
#   Child sites that want preload should opt in explicitly after submission.
# - COOP is `same-origin-allow-popups` so OAuth popups from Microsoft Forms,
#   Zeffy, and other embedded payment / signup flows can postMessage back.
# - CORP is `cross-origin` so the open graph image and SVG/PNG assets remain
#   embeddable on Facebook scraper, partner sites, and Lighthouse.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; upgrade-insecure-requests

# Long-cache fingerprinted Next.js assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static images and svgs are versioned by deploy; cache for a day.
/Images/*
  Cache-Control: public, max-age=86400, must-revalidate
/images/*
  Cache-Control: public, max-age=86400, must-revalidate
/Svgs/*
  Cache-Control: public, max-age=86400, must-revalidate
/documents/*
  Cache-Control: public, max-age=86400, must-revalidate

# security.txt should not be cached for long.
/.well-known/security.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
