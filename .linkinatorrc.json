{
  "skip": [
    "^https://github.com/(?!FreeForCharity/FFC_Single_Page_Template).*",
    "^https://www.linkedin.com/.*",
    "^https://twitter.com/.*",
    "^https://www.facebook.com/.*",
    "^https://forms.monday.com/.*",
    "^mailto:.*",
    "^tel:.*"
  ],
  "timeout": 10000,
  "retry": true,
  "retryErrors": true,
  "retryErrorsCount": 3,
  "retryErrorsJitter": 500,
  "directoryListing": false,
  "urlRewriteSearch": "^http://127\\.0\\.0\\.1:([0-9]+)/([a-z0-9-]+)$",
  "urlRewriteReplace": "http://127.0.0.1:$1/$2.html"
}
